# Server environment variables for MentorLagbe
# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mentorLagbe

# BetterAuth (BETTER_AUTH_URL should be the public frontend origin because
# /api/auth is proxied through Next.js)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:3000

# JWT used by the Express API
JWT_SECRET=replace-with-another-long-random-string

# Google OAuth (BetterAuth social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
